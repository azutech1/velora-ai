# Velora AI deployment configuration
# Vercel: add these values in Project Settings -> Environment Variables.

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=replace_with_walletconnect_project_id
NEXT_PUBLIC_CIRCLE_APP_KIT_KEY=replace_with_circle_app_kit_key
NEXT_PUBLIC_ADMIN_WALLETS=
VELORA_AUTH_SECRET=replace_with_long_random_server_secret

# Supabase backend storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Arc Testnet
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_TESTNET_RPC_FALLBACK_URLS=
NEXT_PUBLIC_ARC_TESTNET_EXPLORER_URL=https://testnet.arcscan.app
NEXT_PUBLIC_ARC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_ARC_TESTNET_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
NEXT_PUBLIC_ARC_TESTNET_STABLEFX_ESCROW_ADDRESS=0x867650F5eAe8df91445971f14d89fd84F0C9a9f8
NEXT_PUBLIC_ARC_TESTNET_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

# Future integrations
NEXT_PUBLIC_ARC_FAUCET_API_URL=
NEXT_PUBLIC_ARC_BRIDGE_ROUTER_ADDRESS=
